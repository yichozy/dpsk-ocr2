# Optional: Authentication Token
# If set, all API requests must provide this token via Bearer Auth.
# If not set, authentication is disabled.
AUTH_TOKEN=your_secure_token_here

# Optional: SQLite Database Path
# Defaults to task_status.db in the current directory.
# You can specify a full path or a directory.
SQLITE_PATH=task_status.db

# Optional: Max Concurrency for Page Processing
# Default is 20. Increase this if you have more GPU memory (e.g. 100 for A100).
MAX_CONCURRENCY=20

# Optional: Max Workers for Task Queue
# Default is 1 for sequential task processing. Increase to process multiple PDFs concurrently.
# Note: Increasing this multiplies your GPU/RAM memory requirements!
MAX_WORKERS=1

# Optional: Logging Level
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default is INFO.
LOG_LEVEL=INFO
